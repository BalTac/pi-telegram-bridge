{
  "name": "pi-telegram-bridge",
  "version": "1.5.1",
  "description": "Lightweight Telegram control for a single pi session: text, photos and voice notes transcribed locally, via BYOK providers or with the agent's own MCP tools. 2.7k lines, no runtime dependencies, no build step.",
  "license": "MIT",
  "author": "BalTac",
  "contributors": [
    "bytesbrains (original pi-telegram-bridge 1.4.1)"
  ],
  "keywords": [
    "single-session",
    "lightweight",
    "pi",
    "pi-coding-agent",
    "extension",
    "telegram",
    "telegram-bot",
    "bridge",
    "voice",
    "voice-notes",
    "speech-to-text",
    "stt",
    "whisper",
    "faster-whisper",
    "transcription",
    "openai-compatible",
    "mcp",
    "agent",
    "ai-agent",
    "cli",
    "automation",
    "remote-control",
    "typescript"
  ],
  "main": "./src/index.ts",
  "files": [
    "src/",
    "skills/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "llms.txt",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BalTac/pi-telegram-bridge.git"
  },
  "homepage": "https://github.com/BalTac/pi-telegram-bridge#readme",
  "engines": {
    "node": ">=18"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "bugs": {
    "url": "https://github.com/BalTac/pi-telegram-bridge/issues"
  }
}
