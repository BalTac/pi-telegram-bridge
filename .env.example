# Telegram bridge for pi
#
# Copy to .env (never commit it) or export these in your shell before starting pi.

# ── Required ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Your numeric chat id (send /start to the bot, then read it from getUpdates)
TELEGRAM_CHAT_ID=123456789

# ── Origin prefix ───────────────────────────────────────────────────────────
# Prepended to every forwarded message so the agent can tell who is talking.
# Change it if you want a different marker (e.g. "[phone]").
PI_TELEGRAM_ORIGIN_PREFIX=[telegram]

# If a message arrives while the agent is already working, it is queued instead
# of being rejected. followUp = run it after the current turn (default);
# steer = inject it into the running turn right away.
# PI_TELEGRAM_DELIVER_AS=followUp

# ── Speech-to-text for voice notes ──────────────────────────────────────────
# Chain of providers, tried in order, first answer wins.
# Values: http, cmd, agent, off
#   http  → OpenAI-compatible /v1/audio/transcriptions (local or cloud)
#   cmd   → command line STT (whisper.cpp CLI, `whisper`, insanely-fast-whisper…)
#   agent → no transcription here; the file path goes to the agent, which can
#           use its own tools, including an MCP transcription server
#   off   → only the path, no attempt
# Default when unset: http (if URL set), cmd (if CMD set), then agent.
# PI_TELEGRAM_STT_CHAIN=http,cmd,agent

# -- http provider: local server (whisper.cpp server, faster-whisper-server,
#    whisper-asr-webservice, LocalAI, the audio server on 127.0.0.1:8123)
# PI_TELEGRAM_STT_URL=http://127.0.0.1:8123/v1/audio/transcriptions
# PI_TELEGRAM_STT_MODEL=whisper-large-v3-turbo
# PI_TELEGRAM_STT_LANG=it          # omit or "auto" to let the model detect it
# PI_TELEGRAM_STT_KEY=             # bearer token, if the endpoint needs one
# PI_TELEGRAM_STT_HEADER=          # extra header, e.g. "x-api-key: abc123"
# PI_TELEGRAM_STT_TIMEOUT_MS=120000

# -- http provider: cloud (BYOK). Same variable set, different URL/model.
# OpenAI:  https://api.openai.com/v1/audio/transcriptions        model=whisper-1 or gpt-4o-transcribe
# Groq:    https://api.groq.com/openai/v1/audio/transcriptions   model=whisper-large-v3-turbo
# Mistral: https://api.mistral.ai/v1/audio/transcriptions        model=voxtral-mini-latest
# DeepInfra / together.ai / Fireworks: same shape, check their docs for model names

# -- cmd provider: any CLI. {file} is replaced with the audio path.
# whisper.cpp (CPU friendly, ggml models):
# PI_TELEGRAM_STT_CMD=whisper-cli -m /models/ggml-base.bin -l it -nt -f {file}
# OpenAI python whisper:
# PI_TELEGRAM_STT_CMD=whisper {file} --model base --language it --output_format txt --output_dir /tmp
# insanely-fast-whisper:
# PI_TELEGRAM_STT_CMD=insanely-fast-whisper --file-name {file} --transcript-path -
